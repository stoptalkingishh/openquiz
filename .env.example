# Google Drive Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials

# Required: OAuth 2.0 Client ID (Application type: Web application).
# Add your site's origin to "Authorized JavaScript origins" (e.g.
# https://your-username.github.io).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Required: API key with the Google Drive API enabled.
# Enable "Google Drive API" at https://console.cloud.google.com/apis/library/drive.googleapis.com
# Then create an API key and optionally restrict it to the Drive API + your site.
NEXT_PUBLIC_GOOGLE_API_KEY=your-api-key

# Optional: your Google Cloud project ID (used for the "x-goog-user-project"
# header when calling the Gemini API via OAuth). Find it in the project
# selector in the Google Cloud Console (e.g. "my-project-123").
# NEXT_PUBLIC_GOOGLE_PROJECT_ID=your-project-id